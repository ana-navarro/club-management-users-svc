# Service
PORT=3001
APP_URL=http://localhost:8081

# Database. Local development uses the MongoDB container.
# Published environments use the Azure DocumentDB connection string.
DATABASE_URL=mongodb://mongo:27017
DATABASE_NAME=ranking-svc

# Token signing key. Use a different random value in each environment.
JWT_SECRET=change-me

# Email. Local development uses Mailpit (host mailpit, port 1025, no user).
# Published environments use Brevo (host smtp-relay.brevo.com, port 587, SMTP_REQUIRE_TLS=true).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Internal mTLS certificates
TLS_CA=/certs/ca.crt
TLS_CERT=/certs/tls.crt
TLS_KEY=/certs/tls.key

# Initial administrator, for development and CI only
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
