# Service
PORT=3001
ADMIN_APP_URL=http://localhost:8081
CLIENT_APP_URL=http://localhost:8080

# Database. Local development uses the MongoDB container.
# Published environments use the Azure DocumentDB connection string.
DATABASE_URL=mongodb://mongo:27017
DATABASE_NAME=ranking-svc

# Token signing key. Use a different random value in each environment.
JWT_SECRET=change-me

# Email. Local development uses Mailpit (host mailpit, port 1025, no user).
# Published environments use Brevo (host smtp-relay.brevo.com, port 587, SMTP_REQUIRE_TLS=true).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Internal mTLS certificates
TLS_CA=/certs/ca.crt
TLS_CERT=/certs/tls.crt
TLS_KEY=/certs/tls.key

# Google and Facebook. These values point to the stand-in at http://localhost:8090 (club-management-infra).
# Without credentials, the provider answers provider_unavailable. The real URLs are the defaults.
GOOGLE_CLIENT_ID=mock-google-client
GOOGLE_CLIENT_SECRET=mock-google-secret
GOOGLE_AUTHORIZE_URL=http://localhost:8090/google/authorize
GOOGLE_TOKEN_URL=http://oauth-mock:8090/google/token
GOOGLE_JWKS_URL=http://oauth-mock:8090/google/jwks
GOOGLE_ISSUERS=http://oauth-mock:8090/google
FACEBOOK_APP_ID=mock-facebook-app
FACEBOOK_APP_SECRET=mock-facebook-secret
FACEBOOK_AUTHORIZE_URL=http://localhost:8090/facebook/dialog/oauth
FACEBOOK_GRAPH_URL=http://oauth-mock:8090/facebook
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_SCOPE=email,public_profile

# Initial administrator, for development and CI only
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
